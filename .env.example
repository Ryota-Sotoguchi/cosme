# ============================================================
# cosme - 環境変数サンプル
# このファイルをコピーして .env を作る（.env は .gitignore 済み）
#   cp .env.example .env
# 本番実行(GitHub Actions)では GitHub Secrets に同名で登録する。
# 実際の値をこのファイルに書き込まないこと。
# ============================================================

# --- 楽天ウェブサービス（2026年新仕様: applicationId と accessKey の両方が必須） ---
# https://webservice.rakuten.co.jp/ でアプリを新規登録して取得
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=

# --- 楽天アフィリエイト ---
# https://affiliate.rakuten.co.jp/ のアフィリエイトID
RAKUTEN_AFFILIATE_ID=

# --- 楽天API の Origin/Referer ヘッダー ---
# 楽天デベロッパーコンソールの「許可Webサイト」に登録したURLと一致させる。
# 未設定なら config/config.toml の既定値が使われる。
RAKUTEN_ORIGIN=

# --- Threads (Meta) ---
# developers.facebook.com のアプリで発行した長期アクセストークン(60日)
THREADS_ACCESS_TOKEN=
# Threads ユーザーID（数値）。未設定なら /me から自動取得する
THREADS_USER_ID=
# 長期トークン交換に必要（App Dashboard の Threads App Secret）
THREADS_APP_SECRET=

# --- 動作モード ---
# true にすると Threads への POST だけを行わない（それ以外は全部実行）
DRY_RUN=true

# --- 任意: トークン自動更新をGitHub Secretsへ書き戻す場合のみ ---
# repo の Actions secrets 書き込み権限を持つ Personal Access Token
GH_PAT=
