# ============================================================
#  cosme — 環境変数
#
#  使い方:
#    cp .env.example .env    してから .env に値を記入する
#
#  .env は .gitignore 済み。絶対にコミットしないこと。
#  値の前後にクォートは不要。= の後にそのまま貼る。
#
#  [必須] が全部埋まれば本番運用できる。
# ============================================================


# ------------------------------------------------------------
# 1. 楽天ウェブサービス
#
#    https://webservice.rakuten.co.jp/ → 「アプリID発行」
#
#    ※2026年のインフラ刷新で applicationId と accessKey の
#      【両方】が必須になった。旧アプリIDは使用不可。
# ------------------------------------------------------------

# [必須] アプリID（数字の羅列）
RAKUTEN_APPLICATION_ID=

# [必須] アクセスキー（英数字の長い文字列）
RAKUTEN_ACCESS_KEY=

# [必須] 楽天API に送る Origin / Referer ヘッダー。
#
#        楽天デベロッパーコンソールでアプリに登録した
#        「アプリURL」「許可Webサイト」と【完全に一致】させること。
#        ここがズレていると全リクエストが 403 になる。
#
#        末尾のスラッシュの有無まで、登録した通りに書く。
RAKUTEN_ORIGIN=https://github.com/Ryota-Sotoguchi/cosme

# ------------------------------------------------------------
# 2. 楽天アフィリエイト
#
#    https://affiliate.rakuten.co.jp/ → 管理画面で確認
# ------------------------------------------------------------

# [必須] アフィリエイトID
RAKUTEN_AFFILIATE_ID=


# ------------------------------------------------------------
# 3. Threads (Meta)
#
#    https://developers.facebook.com/apps/ の cosme アプリ
#
#    (0) 先に「ユースケース」→「Threads APIにアクセス」→「設定」で
#        次の3つのURLを登録して保存する。
#        （未入力だとフォームが保存できず、テスター追加もできない）
#
#          OAuthリダイレクトURI
#            https://ryota-sotoguchi.github.io/cosme/oauth/callback/
#          認証解除コールバックURL
#            https://ryota-sotoguchi.github.io/cosme/deauthorize/
#          データ削除リクエストURL
#            https://ryota-sotoguchi.github.io/cosme/data-deletion/
#
#        ★1つ貼るごとに Enter キーを押して確定させること。
#          確定しないまま「保存する」を押すと弾かれる。
#
#    (1) 同じ画面下部の「Threadsテスターを追加または削除」
#        →「メンバーを追加」→ 自分の Threads ユーザー名を入力
#
#    (2) スマホの Threads アプリを開く
#        → 右上の設定 →「アカウント」
#        →「ウェブサイトのアクセス許可」→「招待」
#        → cosme の「同意する」をタップ
#        ★ここはPCでは完結しない。スマホアプリでの承認が必須。
#
#    (3) Meta の画面に戻り、「設定」画面下部の
#        「ユーザートークン生成ツール」からトークンを生成
#        （(2)の承認が終わるまで生成できない）
#
#    (4) 「ユースケース」→「設定」上部の
#        「Threadsのapp secret」の「表示」を押す
# ------------------------------------------------------------

# [必須] アクセストークン
#
#        Meta の画面で取得できるのは短命トークン（有効1時間）。
#        そのまま貼ってよい。60日トークンへの交換はこちらで実行する。
THREADS_ACCESS_TOKEN=

# [必須] Threads App Secret
#        60日トークンへの交換と、その後の自動更新に必要。
THREADS_APP_SECRET=

# [任意] Threads ユーザーID（数値）
#        空でよい。未設定なら /me から自動取得する。
THREADS_USER_ID=


# ------------------------------------------------------------
# 4. 動作モード
# ------------------------------------------------------------

# [必須] true  = 生成とコンプライアンス検証まで実行し、
#                Threads への投稿だけを行わない
#        false = 本番投稿する
#
#        ローカルでは true のままにしておくのが安全。
#        GitHub Actions 側の定期実行は自動で false になる。
DRY_RUN=true

# [任意] ログの詳細度: DEBUG / INFO / WARNING
LOG_LEVEL=INFO


# ------------------------------------------------------------
# 5. 任意設定
# ------------------------------------------------------------

# [任意] Threads トークンの自動更新結果を GitHub Secrets へ
#        書き戻す場合のみ設定する。
#        repo の Actions secrets 書き込み権限を持つ
#        Personal Access Token。
#
#        未設定でも運用は止まらない（更新時に警告が出るだけ）。
GH_PAT=
