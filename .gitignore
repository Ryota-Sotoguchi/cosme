# --- Secrets: 絶対にコミットしない ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
token.txt
*_token.txt

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- ローカル開発ツールの設定（環境依存なので共有しない） ---
.claude/settings.local.json
.idea/
.vscode/

# --- ログ・一時ファイル ---
*.log
logs/
tmp/
.DS_Store

# --- data/ は「履歴のみ」コミットする。生レスポンスキャッシュは除外 ---
data/cache/
data/*.tmp

# --- 他人の投稿を公開リポジトリに残さない ---
# 返信候補・収集した生データには第三者のユーザー名と本文が含まれる。
# 分析結果（research/PATTERNS.md、research/log/*.md）は自分の文章なので残す。
# ワークフローは成果物（artifact）として保持し、コミットしない。
research/log/raw/
research/replies/
research/dom/

# --- 自動返信（autoreply）のローカル資産。絶対にコミットしない ---
# post.yml / insights.yml / token-refresh.yml は `git add data/` を実行する。
# ここに置いたものは、無視しない限り公開リポジトリへ push される。
#
#   .playwright/  … Threads のセッション Cookie が入る。
#                   載った時点でアカウント乗っ取りと同義。
#   data/engage/  … 第三者のユーザー名・投稿本文・返信本文。
#   engagements.jsonl … 同上（手動返信の記録も含む）。
#
# autoreply はローカル実行専用なので、コミットされなくても運用に支障はない。
.playwright/
data/engage/
data/engagements.jsonl
